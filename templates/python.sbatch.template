#!/bin/bash
#SBATCH --job-name={{job_name}}
#SBATCH --account={{account}}
#SBATCH --partition={{partition}}
#SBATCH --nodes={{nodes}}
#SBATCH --ntasks={{ntasks}}
#SBATCH --time={{walltime}}
#SBATCH --output={{workdir}}/slurm-%j.out
#SBATCH --error={{workdir}}/slurm-%j.err
{% if qos %}#SBATCH --qos={{qos}}{% endif %}

set -euo pipefail
cd "{{repo_root}}"

{% for line in modules %}{{line}}
{% endfor %}
{% if conda_env %}eval "$(conda shell.bash hook)" && conda activate {{conda_env}}{% endif %}

# Step 1 for rounds 1..N: MD with the previous NEP (calorine, CPU).
python {{command}}
