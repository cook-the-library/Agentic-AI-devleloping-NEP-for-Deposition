#!/bin/bash
#SBATCH --job-name={{job_name}}
#SBATCH --account={{account}}
#SBATCH --partition={{partition}}
#SBATCH --nodes={{nodes}}
#SBATCH --ntasks={{ntasks}}
#SBATCH --time={{walltime}}
#SBATCH --output={{workdir}}/slurm-%j.out
#SBATCH --error={{workdir}}/slurm-%j.err
{% if qos %}#SBATCH --qos={{qos}}{% endif %}

set -uo pipefail

{% for line in modules %}{{line}}
{% endfor %}

# Each directory already holds INCAR/POSCAR/POTCAR, staged by submit_vasp.py
# (or setup_check_b.py). Structures run back to back; one failure doesn't stop
# the rest, and finished ones are skipped if the job is resubmitted.
{% for d in dirs %}cd "{{d}}"
if ! grep -q VASP_DONE vasp.out 2>/dev/null; then
  if srun --ntasks={{ntasks}} {{vasp_exe}} > vasp.out 2> vasp.err; then
    echo "VASP_DONE" >> vasp.out
  else
    echo "VASP_FAILED" >> vasp.out
  fi
fi
{% endfor %}
